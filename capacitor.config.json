{
  "appId": "es.topsy.app",
  "appName": "TopSy",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "topsy",
    "hostname": "topsy.es"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "scrollEnabled": true
  },
  "ios": {
    "scheme": "topsy",
    "scrollEnabled": true,
    "keyboardResize": "body"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1A0F05",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#1A0F05",
      "overlaysWebView": false
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    }
  }
}