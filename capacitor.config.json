{
  "appId": "es.topsy.app",
  "appName": "TopSy",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "topsy"
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "scrollEnabled": true
  },
  "ios": {
    "scheme": "topsy"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1A0F05",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}